      "html": "<a class=\"ds-brand\" href=\"#\">Zephyr</a>",
      "css": ".ds-brand{display:inline-flex;align-items:center;font-family:\"Host Grotesk\",ui-sans-serif,sans-serif;font-size:1.1875rem;font-weight:650;letter-spacing:-.02em;color:var(--z-ink,#e6edf3);text-decoration:none}.ds-brand::before{content:\"\";width:1.25rem;height:1.25rem;margin-right:.625rem;border-radius:5px;background:linear-gradient(90deg,#440154,#472c7a,#3b518b,#2c718e,#21908d,#27ad81,#5cc863,#aadc32,#fde725)}.ds-brand:focus-visible{outline:2px solid var(--z-accent,#4fd1a5);outline-offset:2px;border-radius:4px}"
    }
