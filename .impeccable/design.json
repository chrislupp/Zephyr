        "value": "radial-gradient(100% 90% at 50% 55%, #16202b 0%, #0a0e13 100%)",
        "purpose": "Capability visual frames, dark in both themes."
      }
    ],
    "focus": {
      "value": "outline: 2px solid var(--z-accent); outline-offset: 2px; border-radius: 4px",
      "purpose": "Every :focus-visible."
