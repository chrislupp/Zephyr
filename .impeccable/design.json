  "components": [
    {
      "name": "Primary Button (result window)",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The filled near-white action laid over the dark result window: Get started.",
      "html": "<div class=\"ds-window\"><a class=\"ds-btn-primary\" href=\"#\">Get started</a></div>",
      "css": ".ds-window{background:radial-gradient(120% 90% at 62% 58%,#16202b 0%,#0a0e13 70%);padding:24px;border-radius:8px}.ds-btn-primary{display:inline-flex;align-items:center;min-height:3rem;padding:0 1.25rem;border-radius:10px;background:#e6edf3;color:#0a0e13;font-family:\"Host Grotesk\",ui-sans-serif,system-ui,sans-serif;font-size:1rem;font-weight:600;text-decoration:none;transition:background-color 150ms cubic-bezier(0.2, 0.8, 0.2, 1),color 150ms cubic-bezier(0.2, 0.8, 0.2, 1)}.ds-btn-primary:hover{background:#ffffff}.ds-btn-primary:focus-visible{outline:2px solid #4fd1a5;outline-offset:2px}"
    },
    {
      "name": "Install Button",
      "kind": "button",
      "refersTo": "button-install",
      "description": "The install command as an outlined mono button that copies on click.",
      "html": "<div class=\"ds-window\"><button class=\"ds-btn-install\" type=\"button\"><code>cargo add zephyr-vlm</code><span class=\"ds-copy\">Copy</span></button></div>",
      "css": ".ds-window{background:#0a0e13;padding:24px;border-radius:8px}.ds-btn-install{display:inline-flex;align-items:center;gap:.75rem;min-height:3rem;padding:0 1.25rem;border:1px solid #2c3a48;border-radius:10px;background:rgba(18,26,35,.8);color:#e6edf3;font-family:\"Host Grotesk\",ui-sans-serif,system-ui,sans-serif;font-weight:500;cursor:pointer;transition:border-color 150ms cubic-bezier(0.2, 0.8, 0.2, 1)}.ds-btn-install code{font-family:\"Red Hat Mono\",ui-monospace,monospace;font-size:.9375rem;color:#e6edf3}.ds-copy{padding-left:.75rem;border-left:1px solid #2c3a48;font-size:.8125rem;color:#8796a5}.ds-btn-install:hover{border-color:#8796a5}.ds-btn-install:focus-visible{outline:2px solid #4fd1a5;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined themed action below the result window: API reference.",
      "html": "<a class=\"ds-btn-secondary\" href=\"#\">API reference</a>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;min-height:3rem;padding:0 1.25rem;border:1px solid var(--z-line-strong,#2c3a48);border-radius:10px;color:var(--z-ink,#e6edf3);font-family:\"Host Grotesk\",ui-sans-serif,system-ui,sans-serif;font-size:1rem;font-weight:600;text-decoration:none;transition:border-color 150ms cubic-bezier(0.2, 0.8, 0.2, 1)}.ds-btn-secondary:hover{border-color:var(--z-ink-3,#8796a5)}.ds-btn-secondary:focus-visible{outline:2px solid var(--z-accent,#4fd1a5);outline-offset:2px}"
    },
    {
      "name": "Rail",
      "kind": "nav",
      "refersTo": "menu-link-active",
      "description": "The doc sidebar: category head, links, the active page on the teal wash.",
      "html": "<nav class=\"ds-rail\"><div class=\"ds-rail-head\">Guide</div><a class=\"ds-rail-link\" href=\"#\">Loads</a><a class=\"ds-rail-link ds-active\" href=\"#\">Stability analysis</a><a class=\"ds-rail-link\" href=\"#\">Trim</a></nav>",
      "css": ".ds-rail{width:16rem;padding:.75rem .5rem;background:var(--z-ground,#0a0e13);border-right:1px solid var(--z-line,#1f2a35);font-family:\"Host Grotesk\",ui-sans-serif,system-ui,sans-serif;font-size:.9375rem}.ds-rail-head{padding:.375rem .75rem;font-size:.8125rem;font-weight:600;color:var(--z-ink,#e6edf3)}.ds-rail-link{display:block;padding:.375rem .75rem;border-radius:6px;line-height:1.35;color:var(--z-ink-2,#a9b6c3);text-decoration:none;transition:color 150ms cubic-bezier(0.2, 0.8, 0.2, 1)}.ds-rail-link:hover{background:var(--z-raised,#161e27)}.ds-rail-link.ds-active{background:var(--z-accent-soft,rgba(79,209,165,.1));color:var(--z-accent-ink,#6fdcb6);font-weight:600}.ds-rail-link:focus-visible{outline:2px solid var(--z-accent,#4fd1a5);outline-offset:2px}"
    },
    {
      "name": "Code Block",
      "kind": "card",
      "refersTo": "code-block",
      "description": "A titled Rust listing on the surface colour with a 1px rule and no shadow.",
      "html": "<div class=\"ds-code\"><div class=\"ds-code-title\">main.rs</div><pre><code><span class=\"k\">let</span> lift = TotalDerivative::<span class=\"f\">compute</span>(&amp;solver, &amp;condition, AeroOutput::Lift)?;\n<span class=\"f\">println!</span>(<span class=\"s\">\"dCL/dalpha = {}\"</span>, lift.by_alpha);</code></pre></div>",
      "css": ".ds-code{border:1px solid var(--z-line,#1f2a35);border-radius:8px;background:#10161d;overflow:hidden}.ds-code-title{padding:.5rem 1.125rem;border-bottom:1px solid var(--z-line,#1f2a35);font-family:\"Host Grotesk\",ui-sans-serif,sans-serif;font-size:.8125rem;font-weight:600;color:#a9b6c3}.ds-code pre{margin:0;padding:1.125rem;overflow-x:auto}.ds-code code{font-family:\"Red Hat Mono\",ui-monospace,monospace;font-size:.875rem;line-height:1.65;color:#e6edf3;font-variant-ligatures:none}.ds-code .k{color:#c4a7f5}.ds-code .f{color:#8fc3ff}.ds-code .s{color:#6fdcb6}"
    },
    {
      "name": "Table",
      "kind": "card",
      "refersTo": "table-head",
      "description": "A rounded, bordered table block with a raised head and row rules only.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Case</th><th>Panels</th></tr></thead><tbody><tr><td>wing_tail</td><td>44</td></tr><tr><td>ucrm_17_40</td><td>680</td></tr></tbody></table>",
      "css": ".ds-table{border:1px solid var(--z-line,#1f2a35);border-radius:8px;border-collapse:separate;border-spacing:0;overflow:hidden;font-family:\"Host Grotesk\",ui-sans-serif,sans-serif;font-size:.9375rem;line-height:1.5;color:var(--z-ink,#e6edf3)}.ds-table th{background:var(--z-raised,#161e27);font-size:.8125rem;font-weight:600;color:var(--z-ink-2,#a9b6c3);text-align:left}.ds-table th,.ds-table td{padding:.625rem .875rem;border-bottom:1px solid var(--z-line,#1f2a35)}.ds-table tbody tr:last-child td{border-bottom:0}"
    },
    {
      "name": "Note",
      "kind": "card",
      "refersTo": "alert",
      "description": "An admonition: surface fill, 1px strong rule, no shadow; caution amber for warnings.",
      "html": "<div class=\"ds-note\"><div class=\"ds-note-head\">NOTE</div><p>Twist and incidence are degrees; flight angles are <a href=\"#\">radians</a>.</p></div><div class=\"ds-note ds-warn\"><div class=\"ds-note-head\">WARNING</div><p>Released snapshots are frozen.</p></div>",
      "css": ".ds-note{max-width:42rem;margin-bottom:12px;padding:1rem;border:1px solid var(--z-line-strong,#2c3a48);border-radius:8px;background:var(--z-surface,#10161d);color:var(--z-ink,#e6edf3);font-family:\"Host Grotesk\",ui-sans-serif,sans-serif}.ds-warn{border-color:#b7791f}.ds-note-head{font-size:.8125rem;font-weight:600;letter-spacing:.02em}.ds-note p{margin:.5rem 0 0}.ds-note a{color:var(--z-accent-ink,#6fdcb6);text-decoration:underline}"
    },
    {
      "name": "Pager Link",
      "kind": "card",
      "refersTo": "pager-link",
      "description": "Next/previous page box whose border turns accent on hover.",
      "html": "<a class=\"ds-pager\" href=\"#\"><span class=\"ds-pager-sub\">Next</span><span class=\"ds-pager-label\">Stability analysis</span></a>",
      "css": ".ds-pager{display:flex;flex-direction:column;gap:.25rem;padding:1rem;border:1px solid var(--z-line,#1f2a35);border-radius:8px;background:var(--z-surface,#10161d);text-decoration:none;font-family:\"Host Grotesk\",ui-sans-serif,sans-serif;transition:border-color 150ms cubic-bezier(0.2, 0.8, 0.2, 1)}.ds-pager:hover{border-color:var(--z-accent,#4fd1a5)}.ds-pager:focus-visible{outline:2px solid var(--z-accent,#4fd1a5);outline-offset:2px}.ds-pager-sub{font-size:.8125rem;color:var(--z-ink-3,#8796a5)}.ds-pager-label{font-weight:600;color:var(--z-accent-ink,#6fdcb6)}"
    },
    {
      "name": "Readouts and Colour Bar",
      "kind": "custom",
      "refersTo": "colour-bar",
      "description": "The result window's bottom strip: mono solver readouts and the viridis panel-loading colour bar.",
      "html": "<dl class=\"ds-readouts\"><div><dt>C<sub>L</sub></dt><dd>0.1723</dd></div><div><dt>C<sub>Di</sub></dt><dd>0.00340</dd></div><div class=\"ds-scale\"><dt>Panel loading ΔC<sub>p</sub></dt><dd><i class=\"ds-ramp\"></i><span class=\"ds-ticks\"><span>0</span><span>0.5</span><span>≥ 1.0</span></span></dd></div></dl>",
      "css": ".ds-readouts{display:flex;flex-wrap:wrap;align-items:flex-end;gap:1.5rem 3rem;margin:0;padding:24px;border-radius:8px;background:#0a0e13;font-family:\"Host Grotesk\",ui-sans-serif,sans-serif}.ds-readouts dt{font-size:.8125rem;color:#8796a5}.ds-readouts dd{margin:.375rem 0 0;font-family:\"Red Hat Mono\",ui-monospace,monospace;font-size:1.25rem;font-weight:500;color:#e6edf3}.ds-scale{margin-left:auto;width:19rem}.ds-ramp{display:block;height:8px;margin:.5rem 0 .375rem;border-radius:4px;background:linear-gradient(90deg,#440154,#472c7a,#3b518b,#2c718e,#21908d,#27ad81,#5cc863,#aadc32,#fde725)}.ds-ticks{display:flex;justify-content:space-between;font-family:\"Host Grotesk\",ui-sans-serif,sans-serif;font-size:.75rem;color:#8796a5}"
    },
    {
      "name": "Brand Mark",
      "kind": "custom",
      "refersTo": "brand-mark",
